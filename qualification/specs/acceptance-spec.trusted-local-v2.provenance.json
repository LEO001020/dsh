    {
      "v1_case_id": "DATA-09",
      "v2_case_ids": [
        "DATA-09",
        "DATA-13"
      ],
      "treatment": "split",
      "oracle_changed": true,
      "authority": "D2",
      "reason": "v1 conflated two different epistemic things in one closed set: whether the WORLD gave us complete data (an acquisition fact) and how much of complete data the LLM was shown (a projection choice). v2 splits them. This case keeps the acquisition half.",
      "dropped_assertions": [
        "`transport` as a required acquisition stage",
        "`model-projection` as a required acquisition stage"
      ],
      "why_not_a_loss": "`transport` has no producer because the product REJECTS an oversized frame before any successful value exists, so there is no partial success to attribute; requiring the stage would mean degrading a hard failure into a silent one. `model-projection` becomes DATA-13's ProjectionManifest, where an intentional projection is recorded as a manifest rather than as a loss.",
      "note_on_counts": null
    },
