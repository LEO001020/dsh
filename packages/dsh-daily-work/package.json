{
  "name": "dsh-daily-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mandatory rolling child-assignment top-up for the DSH native daily system. NOT an official @deepseek-ai package.",
  "license": "MIT",
  "main": "lib/host-plugin.js",
  "exports": {
    "./host": {
      "types": "./lib/host-plugin.d.ts",
      "default": "./lib/host-plugin.js"
    },
    "./package.json": "./package.json",
    "./service": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./tool-protocol-guards": {
      "types": "./lib/tool-protocol-guards.d.ts",
      "default": "./lib/tool-protocol-guards.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./web-search": {
      "types": "./lib/web-search-plugin.d.ts",
      "default": "./lib/web-search-plugin.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
