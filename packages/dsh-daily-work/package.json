{
  "name": "dsh-daily-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mandatory rolling child-assignment top-up for the DSH native daily system. NOT an official @deepseek-ai package.",
  "license": "MIT",
  "main": "lib/host.js",
  "exports": {
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "typescript": "^6.0.3"
  }
}
